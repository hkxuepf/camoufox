+  </div>
+
+  <div class="sandbox-stage">
+    <div id="sandboxViewport" class="sandbox-viewport">
+      <!-- Header -->
+      <div class="header">
+        <div class="brand-title" id="envTitle">社交账号管理系统</div>
+        <button class="btn-refresh" onclick="refreshAll()">
+          <span>🔄 刷新</span>
+        </button>
+      </div>
+
+      <!-- Quick Omnibox Search -->
+      <div class="search-box-wrap">
+        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
+          <circle cx="11" cy="11" r="8"></circle>
+          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
+        </svg>
+        <input type="text" class="search-input" id="searchInput" placeholder="在 Google 中搜索或输入网址..." onkeydown="handleSearch(event)">
+      </div>
+
+      <!-- Hero IP -->
+      <div class="hero-ip-card">
+        <div class="ip-display-row">
+          <div class="ip-check-icon">✓</div>
+          <div class="ip-number" id="ipDisplay">探查中...</div>
+        </div>
+        <div class="ping-row">
+          <div class="ping-badge ok" id="pingTikTok"><span>TikTok</span> <span class="val">✓ 检测中</span></div>
+          <div class="ping-badge ok" id="pingGoogle"><span>Google</span> <span class="val">✓ 检测中</span></div>
+          <div class="ping-badge ok" id="pingBaidu"><span>Baidu</span> <span class="val">✓ 检测中</span></div>
+          <div class="ping-badge ok" id="pingFacebook"><span>Facebook</span> <span class="val">✓ 检测中</span></div>
+          <div class="ping-badge ok" id="pingIphey"><span>Iphey</span> <span class="val">✓ 检测中</span></div>
+        </div>
+      </div>
+
+      <!-- Info Grid -->
+      <div class="info-grid">
+        <div class="info-card">
+          <div class="info-title">地理位置 / 地区</div>
+          <div class="info-value" id="geoDisplay">国家/地区: 探测中...<br>州/省: --, 城市: --</div>
+        </div>
+        <div class="info-card">
+          <div class="info-title">指纹与虚拟硬件拓扑</div>
+          <div class="info-value" id="hwDisplay">内核: Chromium 155<br>物理分辨率: 1024 × 768</div>
