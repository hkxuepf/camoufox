+      </div>
+
+      <!-- Quick Docks -->
+      <div class="dock-grid">
+        <a href="https://iphey.com" class="dock-item"><span class="dock-icon">🛡️</span>Iphey</a>
+        <a href="https://whoer.net" class="dock-item"><span class="dock-icon">🕵️</span>Whoer</a>
+        <a href="https://browserleaks.com" class="dock-item"><span class="dock-icon">🧪</span>BrowserLeaks</a>
+        <a href="https://pixelscan.net" class="dock-item"><span class="dock-icon">🎯</span>Pixelscan</a>
+        <a href="https://www.browserscan.net" class="dock-item"><span class="dock-icon">🔍</span>BrowserScan</a>
+        <a href="https://ping0.cc/env" class="dock-item"><span class="dock-icon">⚡</span>Ping0</a>
+      </div>
+    </div>
+  </div>
+
+  <script>
+    let targetW = 1024;
+    let targetH = 768;
+    let currentMode = 'fit';
+
+    function setViewportScale(mode) {
+      currentMode = mode;
+      const vp = document.getElementById('sandboxViewport');
+      if (!vp) return;
+      if (mode === 'fit') {
+        const availW = (window.innerWidth || 1280) - 48;
+        const availH = (window.innerHeight || 800) - 60;
+        const scaleW = availW / targetW;
+        const scaleH = availH / targetH;
+        const scale = Math.min(1, Math.min(scaleW, scaleH));
+        vp.style.transform = 'scale(' + scale + ')';
+      } else {
+        const s = parseInt(mode, 10) / 100;
+        vp.style.transform = 'scale(' + s + ')';
+      }
+    }
+
+    window.addEventListener('resize', () => {
+      if (currentMode === 'fit') setViewportScale('fit');
+    });
+
+    function handleSearch(e) {
+      if (e.key === 'Enter') {
+        const q = e.target.value.trim();
+        if (!q) return;
+        if (/^https?:\/\//i.test(q)) {
+          window.location.href = q;
+        } else if (/^[a-zA-Z0-9-]+\.[a-zA-Z]{2,}(\/.*)?$/.test(q)) {
+          window.location.href = 'https://' + q;
+        } else {
+          window.location.href = 'https://www.google.com/search?q=' + encodeURIComponent(q);
+        }
+      }
+    }
+
+    // Trusted-Types-safe DOM update helpers
+    function setSafeLines(id, lines) {
+      const el = document.getElementById(id);
+      if (!el) return;
+      while (el.firstChild) el.removeChild(el.firstChild);
+      lines.forEach((line, idx) => {
+        if (idx > 0) el.appendChild(document.createElement('br'));
+        el.appendChild(document.createTextNode(line));
+      });
+    }
+
+    function setBadgeVal(id, val) {
+      const el = document.getElementById(id);
+      if (!el) return;
+      const valSpan = el.querySelector('.val');
+      if (valSpan) {
+        valSpan.textContent = val;
+      }
+    }
+
+    window.updateRadarData = function(data) {
+      if (!data) return;
+      if (data.envTitle) {
+        const t = document.getElementById('envTitle');
+        if (t) t.textContent = data.envTitle;
+      }
+      if (data.ip) {
+        const ipEl = document.getElementById('ipDisplay');
+        if (ipEl) ipEl.textContent = data.ip;
+      }
+      if (data.country || data.city || data.region) {
+        setSafeLines('geoDisplay', [
+          '国家/地区: ' + (data.country || '探查中...'),
+          '州/省: ' + (data.region || '--') + ', 城市: ' + (data.city || '--')
+        ]);
+      }
+      if (data.targetW && data.targetH) {
+        targetW = data.targetW;
+        targetH = data.targetH;
+        const vp = document.getElementById('sandboxViewport');
+        if (vp) {
+          vp.style.width = targetW + 'px';
+          vp.style.minHeight = targetH + 'px';
+        }
+        setSafeLines('hwDisplay', [
+          '内核: Chromium 155',
+          '物理分辨率: ' + targetW + ' × ' + targetH + ' (受控物理沙盒视口)'
+        ]);
+        setViewportScale(currentMode);
+      }
+      if (data.pings) {
+        for (const [k, v] of Object.entries(data.pings)) {
+          setBadgeVal('ping' + k, '✓ ' + v);
+        }
+      }
+    };
+
+    function refreshAll() {
+      const ipEl = document.getElementById('ipDisplay');
+      if (ipEl && ipEl.textContent === '探查中...') {
+        ipEl.textContent = '检测连接中...';
+      }
+      const w = window.screen.width || window.innerWidth;
+      const h = window.screen.height || window.innerHeight;
+      targetW = w > 600 ? w : 1024;
+      targetH = h > 400 ? h : 768;
+      const vp = document.getElementById('sandboxViewport');
+      if (vp) {
+        vp.style.width = targetW + 'px';
+        vp.style.minHeight = targetH + 'px';
+      }
+      setSafeLines('hwDisplay', [
+        '操作系统: ' + (navigator.platform || 'Windows'),
+        '物理分辨率: ' + targetW + ' × ' + targetH,
+        '核心数: ' + (navigator.hardwareConcurrency || 8) + ' 核心, 内存: ' + (navigator.deviceMemory || 8) + ' GB'
+      ]);
+      setViewportScale(currentMode);
+    }
+
+    window.addEventListener('DOMContentLoaded', () => {
+      setViewportScale('fit');
+      refreshAll();
+    });
+  </script>
+</body>
 </html>
